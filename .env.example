# Sans clé : les agents fonctionnent en mode « règles » (déterministe, gratuit).
# Avec une clé : l'extraction et la rédaction passent par le LLM, avec repli automatique sur les règles en cas d'erreur.
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
